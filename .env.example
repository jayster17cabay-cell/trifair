APP_NAME=TriFair
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://trifair.onrender.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Render terminates TLS at its edge and forwards plain HTTP to the container.
# Trusting "*" makes Laravel trust ONLY the immediate caller (Render's proxy),
# so X-Forwarded-Proto/For are honored — fixing https URL generation and signed
# URLs (proof links), and giving real client IPs for rating dedup (which is also
# keyed on a signed cookie, so the cookie layer covers any header spoofing).
TRUSTED_PROXIES=*

DB_CONNECTION=pgsql

# Non-secret defaults live in config/database.php (Supabase transaction pooler).
# Override here or via Render env if you use a different database.
# PGSQL_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# PGSQL_PORT=6543
# PGSQL_DATABASE=postgres
# PGSQL_USERNAME=postgres.lkmmudpfcxbykwdpsqvy
PGSQL_PASSWORD=your-db-password
PGSQL_SSLMODE=require

# Supabase storage (proof uploads) — set via Render dashboard / .env
SUPABASE_URL=https://lkmmudpfcxbykwdpsqvy.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=proofs

# Token for /cleanup admin route (must be set, required in all environments)
CLEANUP_TOKEN=your-cleanup-token

# Google OAuth login (superadmin / TFRB Officer "Sign in with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
# Configure the authorized redirect URI below in the Google Cloud Console.
GOOGLE_CLIENT_ID=877167041441-rnahjnhl7ke6ru7m5i3654gs2c6rtf95.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://trifair.onrender.com/auth/google/callback

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Brevo (ex-Sendinblue) HTTP API (works on Render free tier, which blocks SMTP
# ports 25/465/587). Set SENDINBLUE_KEY via Render dashboard / .env (do not
# commit secrets).
MAIL_MAILER=sendinblue
SENDINBLUE_KEY=your-brevo-api-key

# Deliverability, two phases:
#
# 1) No domain yet (current): use a sender address you have verified in Brevo
#    (Senders -> Add a sender). Mail is delivered, but because the From domain
#    (e.g. gmail.com) cannot be authenticated with Brevo's DKIM/SPF, Gmail and
#    Outlook may still put it in spam. Ask recipients to add the sender to their
#    contacts / mark it "Not spam" — that slowly builds sender reputation.
#
# 2) Once a domain is authenticated in Brevo (SPF + DKIM + DMARC), switch to a
#    no-reply address on that domain. This is the real fix for spam placement.
MAIL_FROM_ADDRESS="your-verified-sender@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="support@your-verified-domain.com"
MAIL_REPLY_TO_NAME="${APP_NAME} Support"

# Gmail API transport — recommended while there is no custom domain.
#
# A @gmail.com From address sent through Brevo cannot pass DMARC alignment and
# Gmail files it under Spam. The Gmail API sends as the real mailbox over HTTPS,
# so SPF/DKIM/DMARC pass and no domain purchase is needed. Render's free tier
# blocks outbound SMTP, but HTTPS works fine.
#
# One-time setup:
#   1. Google Cloud Console -> APIs & Services -> Library -> enable "Gmail API".
#   2. OAuth consent screen -> add scope https://www.googleapis.com/auth/gmail.send
#      and set Publishing status to "In production" (Testing-mode refresh
#      tokens expire after 7 days).
#   3. Credentials -> OAuth client (Web application) -> add
#      https://developers.google.com/oauthplayground as an authorized redirect URI.
#   4. Open https://developers.google.com/oauthplayground -> gear icon -> "Use
#      your own OAuth credentials" -> authorize the gmail.send scope -> exchange
#      the authorization code for tokens -> copy the refresh token.
#   5. Fill in the values below. MAIL_FROM_ADDRESS must equal GMAIL_API_SENDER.
#      TransactionalMail switches to Gmail automatically once all four are set.
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_SENDER="your-sender@gmail.com"

APP_TIMEZONE=Asia/Manila
