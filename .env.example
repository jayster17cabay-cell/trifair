APP_NAME=TriFair
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://trifair.onrender.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql

# Non-secret defaults live in config/database.php (Supabase transaction pooler).
# Override here or via Render env if you use a different database.
# PGSQL_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# PGSQL_PORT=6543
# PGSQL_DATABASE=postgres
# PGSQL_USERNAME=postgres.lkmmudpfcxbykwdpsqvy
PGSQL_PASSWORD=your-db-password
PGSQL_SSLMODE=require

# Supabase storage (proof uploads) — set via Render dashboard / .env
SUPABASE_URL=https://lkmmudpfcxbykwdpsqvy.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=proofs

# Token for /cleanup admin route (must be set, required in all environments)
CLEANUP_TOKEN=your-cleanup-token

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Mailjet HTTP API (Render free blocks SMTP ports 25/465/587)
MAIL_MAILER=mailjet
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAIL_FROM_ADDRESS="jayster17cabay@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
